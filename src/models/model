classDiagram
    class TimeModel {
        -hours: number
        -minutes: number
        -seconds: number
        -editMode: EditMode
        +getTime(): string
        +updateTime()
        +incrementHours()
        +incrementMinutes()
        +getEditMode(): EditMode
        +setEditMode(mode: EditMode)
    }

    class ClockView {
        -display: HTMLElement
        -editingClass: string
        -backgroundColor: string
        +updateDisplay(time: string)
        +setEditMode(mode: EditMode)
        +toggleBackground()
    }

    class ClockController {
        -model: TimeModel
        -view: ClockView
        +handleModeButton()
        +handleIncreaseButton()
        +handleLightButton()
        +start()
    }

    class EditMode {
        <<enumeration>>
        NONE
        HOURS
        MINUTES
    }

    ClockController --> TimeModel
    ClockController --> ClockView
    TimeModel -- EditMode